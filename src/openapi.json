{
  "openapi": "3.0.3",
  "info": {
    "title": "PR-мониторинг API",
    "description": "API веб-интерфейса команды: факты публикаций, перепечатки, охват, автоматический поиск упоминаний.\n\nАвтоматизация (n8n) использует эндпоинты `/api/cron/*` — они защищены заголовком `X-Automation-Api-Key`. Кабинет команды и админ-панель (`/api/team/*`, `/api/admin/*`) работают через cookie-сессию Mattermost.",
    "version": "0.1.0"
  },
  "servers": [{ "url": "/" }],
  "security": [{ "automationApiKey": [] }],
  "tags": [
    { "name": "Автоматизация", "description": "Машинные эндпоинты для внешних систем (n8n). Защита: заголовок X-Automation-Api-Key." },
    { "name": "Кабинет команды", "description": "Вкладки «Текущие задачи», «WEB», «Статистика». Защита: cookie-сессия Mattermost." },
    { "name": "Администрирование", "description": "Настройка проектов, ссылки клиентов, карточки клиентов. Требуются права админа." },
    { "name": "Клиентский кабинет", "description": "Анонимные ссылки клиентов на факты публикаций." }
  ],
  "paths": {
    "/api/cron/scenarios": {
      "get": {
        "tags": ["Автоматизация"],
        "summary": "Актуальные сценарии поиска",
        "description": "Возвращает только активные (не архивные) сценарии поиска — «фильтры», которые автоматизация должна выполнять. Сценарий: ключевые слова, источники/ссылки, позитивные и негативные ключи, URL поиска (feedUrl) и/или регулярное выражение (regex) для фильтрации найденного. Приоритет: если задан feedUrl — автоматизация обращается к этому URL как есть (Яндекс, Google, RSS/API); иначе формирует запрос из keywords/sources. Найденные материалы фильтруются по regex (заголовок+описание), затем размещаются через POST /api/cron/mentions.",
        "security": [{ "automationApiKey": [] }],
        "responses": {
          "200": {
            "description": "Список активных сценариев",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScenariosResponse" },
                "examples": {
                  "scenarioWithFeedUrl": {
                    "summary": "Сценарий с URL поиска Яндекса (ежесуточно)",
                    "value": {
                      "boardId": "team",
                      "scenarios": [
                        {
                          "id": 1,
                          "projectId": "project-42",
                          "name": "Клеверспорт — мониторинг",
                          "keywords": ["КЛЕВЕРСПОРТ"],
                          "sources": [],
                          "negativeKeywords": ["суд", "штраф"],
                          "positiveKeywords": ["рост", "лидер"],
                          "regex": "(?:КЛЕВЕРСПОРТ|Клевер[- ]?Спорт)",
                          "feedUrl": "https://yandex.ru/search/?text=КЛЕВЕРСПОРТ&lr=213&within=1"
                        }
                      ]
                    }
                  },
                  "scenarioWithoutFeed": {
                    "summary": "Сценарий без feedUrl (автоматизация сама формирует запрос из keywords/sources)",
                    "value": {
                      "boardId": "team",
                      "scenarios": [
                        {
                          "id": 2,
                          "projectId": "project-7",
                          "name": "Имя директора — упоминания",
                          "keywords": ["Иванов И.И.", "гендиректор"],
                          "sources": [],
                          "negativeKeywords": [],
                          "positiveKeywords": [],
                          "regex": "",
                          "feedUrl": ""
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/cron/search-run": {
      "post": {
        "tags": ["Автоматизация"],
        "summary": "Запустить поиск по сценариям через Yandex Search API",
        "description": "Выполняет веб-поиск сам (использует YANDEX_SEARCH_API_KEY / YANDEX_SEARCH_FOLDER_ID из env): строит запрос из ключевых слов и источников сценария, получает XML-выдачу Яндекса, фильтрует по негативным ключам и regex, сохраняет находки (как /api/cron/mentions) и пишет лог запуска (видный в «Логи поиска»). Без scenarioId обрабатывает все активные сценарии. `pages` — сколько страниц выдачи запросить (1–5).",
        "security": [{ "automationApiKey": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результаты запусков",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchRunResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/cron/mentions": {
      "post": {
        "tags": ["Автоматизация"],
        "summary": "Разместить найденные материалы",
        "description": "Размещает найденные автоматизацией материалы в БД. Заголовок и краткая информация — отдельные поля (`title`, `comment`). Идемпотентно: при повторе строки с тем же (projectId, url) пропускаются. `projectId` можно задать один раз на уровне body — унаследуется всеми items.",
        "security": [{ "automationApiKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ImportMentionsRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Результат импорта",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportMentionsResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/SearchFailed" }
        }
      }
    },
    "/api/team/login": {
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Вход в кабинет",
        "description": "Авторизация по логину/паролю Mattermost. Устанавливает cookie-сессию. Или с PAT-токеном (login_id + password с паспортом) — зависит от настроек сервера.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный вход",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "description": "Неверный логин или пароль" }
        }
      }
    },
    "/api/team/logout": {
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Выход из кабинета",
        "responses": {
          "200": { "description": "Сессия закрыта", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/team/me": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Текущий пользователь",
        "responses": {
          "200": {
            "description": "Данные пользователя и доступы",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } }
          },
          "401": { "description": "Нет сессии" }
        }
      }
    },
    "/api/team/projects": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Список проектов (без архивных)",
        "responses": {
          "200": { "description": "Проекты борда", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectsResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/MattermostError" }
        }
      }
    },
    "/api/team/tasks": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Задачи команды",
        "description": "Задачи и факты публикаций. Параметры: project (id проекта), fact=1 (только факты публикаций), status (подстрока статуса).",
        "parameters": [
          { "name": "project", "in": "query", "schema": { "type": "string" }, "description": "ID проекта. Пусто — все проекты." },
          { "name": "fact", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] }, "description": "Если 1 — только опубликованные факты." },
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "Фильтр по статусу (подстрока)." }
        ],
        "responses": {
          "200": { "description": "Задачи", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TasksResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/MattermostError" }
        }
      }
    },
    "/api/team/search-scenarios": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Сценарии поиска (все)",
        "responses": {
          "200": { "description": "Сценарии", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenariosResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Создать сценарий поиска",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioInput" } } }
        },
        "responses": {
          "200": { "description": "Созданный сценарий", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/search-scenarios/{id}": {
      "put": {
        "tags": ["Кабинет команды"],
        "summary": "Обновить сценарий поиска",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioInput" } } }
        },
        "responses": {
          "200": { "description": "Обновлённый сценарий", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Сценарий не найден" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "delete": {
        "tags": ["Кабинет команды"],
        "summary": "Удалить сценарий поиска",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Удалён", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Сценарий не найден" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/search-run/{id}": {
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Запустить сценарий прямо сейчас (кнопка «Запустить сейчас»)",
        "description": "Выполняет поиск по сценарию через Yandex Search API (нужен ключ в env сервера), сохраняет новые упоминания и пишет запись в «Логи поиска».",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Результат запуска", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "run": { "$ref": "#/components/schemas/SearchRunEntry" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Сценарий не найден" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/mentions": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Упоминания проекта (вкладка WEB)",
        "parameters": [{ "name": "project", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Список упоминаний", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionsResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Создать упоминание вручную",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionInput" } } }
        },
        "responses": {
          "200": { "description": "Созданное упоминание", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/mentions/{id}": {
      "put": {
        "tags": ["Кабинет команды"],
        "summary": "Обновить упоминание",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "project", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionInput" } } }
        },
        "responses": {
          "200": { "description": "Обновлённое упоминание", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Упоминание не найдено" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "delete": {
        "tags": ["Кабинет команды"],
        "summary": "Удалить упоминание",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "project", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Удалено", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Упоминание не найдено" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/mentions/stats": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Помесячная статистика упоминаний",
        "parameters": [{ "name": "project", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Статистика", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MentionsStatsResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/links/{token}": {
      "get": {
        "tags": ["Клиентский кабинет"],
        "summary": "По токену ссылки клиента — имя проекта",
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Проект",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "boardId": { "type": "string" }, "projectId": { "type": "string" }, "name": { "type": "string" } } } } }
          },
          "404": { "description": "Ссылка недействительна" },
          "502": { "$ref": "#/components/responses/MattermostError" }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": ["Клиентский кабинет"],
        "summary": "Факты публикаций клиента",
        "parameters": [{ "name": "project", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Факты", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TasksResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "description": "Проект не найден" },
          "502": { "$ref": "#/components/responses/MattermostError" }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["Администрирование"],
        "summary": "Проекты и ссылки клиентов (админ)",
        "responses": {
          "200": { "description": "Проекты со ссылками", "content": { "application/json": { "schema": { "type": "object", "properties": { "projects": { "type": "array", "items": { "$ref": "#/components/schemas/AdminProject" } }, "statuses": { "$ref": "#/components/schemas/StatusOptions" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/MattermostError" }
        }
      }
    },
    "/api/projects/{projectId}/regenerate-link": {
      "post": {
        "tags": ["Администрирование"],
        "summary": "Перегенерировать ссылку клиента",
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Новый токен",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "token": { "type": "string" }, "link": { "type": "string", "example": "/l/abc123" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/admin/projects/{projectId}/settings": {
      "get": {
        "tags": ["Администрирование"],
        "summary": "Настройки/карточка клиента",
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Настройки",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "settings": { "$ref": "#/components/schemas/ProjectSettings" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "put": {
        "tags": ["Администрирование"],
        "summary": "Сохранить настройки клиента",
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectSettings" } } }
        },
        "responses": {
          "200": {
            "description": "Сохранено",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "settings": { "$ref": "#/components/schemas/ProjectSettings" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/cron/search-logs": {
      "post": {
        "tags": ["Автоматизация"],
        "summary": "Записать логи запуска сценариев",
        "description": "Внешняя автоматизация (n8n) сообщает, что сценарий поиска был выполнен: результат и примечания. Header: X-Automation-Api-Key.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchLogsRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Записано",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchLogsResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/search-logs": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Логи поиска (попап «Логи поиска»)",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 100 } },
          { "name": "severity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["info", "debug", "important"] }, "description": "Фильтр по критичности" },
          { "name": "project", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Показывать логи только этого проекта" }
        ],
        "responses": {
          "200": {
            "description": "Логи",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "logs": { "type": "array", "items": { "$ref": "#/components/schemas/SearchLog" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/sources": {
      "get": {
        "tags": ["Кабинет команды"],
        "summary": "Источники (база СМИ/сайтов, ядро ~20 ресурсов на клиента). Пустой projectId = общий пул.",
        "parameters": [
          { "name": "project", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Фильтр по проекту (возвращает и общие ресурсы)" },
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Поиск по названию/адресу" },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["active", "paused"] } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["smi", "portal", "aggregator", "telegram", "other"] } },
          { "name": "lang", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ru", "en", "other"] } }
        ],
        "responses": {
          "200": {
            "description": "Список источников",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "sources": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "post": {
        "tags": ["Кабинет команды"],
        "summary": "Добавить источник",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceInput" } } } },
        "responses": {
          "200": { "description": "Созданный источник", "content": { "application/json": { "schema": { "type": "object", "properties": { "source": { "$ref": "#/components/schemas/Source" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    },
    "/api/team/sources/{id}": {
      "put": {
        "tags": ["Кабинет команды"],
        "summary": "Обновить источник",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceInput" } } } },
        "responses": {
          "200": { "description": "Обновлённый источник", "content": { "application/json": { "schema": { "type": "object", "properties": { "source": { "$ref": "#/components/schemas/Source" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      },
      "delete": {
        "tags": ["Кабинет команды"],
        "summary": "Удалить источник",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Удалён", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "502": { "$ref": "#/components/responses/DbError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "automationApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Automation-Api-Key"
      }
    },
    "responses": {
      "Unauthorized": { "description": "Нет авторизации (неверный ключ автоматизации или отсутствует сессия)" },
      "BadRequest": { "description": "Ошибка запроса" },
      "NotFound": { "description": "Не найдено" },
      "DbError": { "description": "Ошибка базы данных", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } } } } },
      "MattermostError": { "description": "Mattermost недоступен", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } } } } },
      "SearchFailed": { "description": "Ошибка при импорте/поиске", "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } } } } }
    },
    "schemas": {
      "Ok": { "type": "object", "properties": { "ok": { "type": "boolean" } } },
      "Scenario": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "projectId": { "type": "string" },
          "name": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" }, "example": ["ФЛГ", "компания А"] },
          "sources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Сайт/источник, где нужно искать. Можно передавать как домен, site: или полный URL.",
            "examples": [["site:kommersant.ru", "https://www.interfax.ru", "вконтакте"]]
          },
          "negativeKeywords": { "type": "array", "items": { "type": "string" } },
          "positiveKeywords": { "type": "array", "items": { "type": "string" } },
          "regex": { "type": "string", "description": "Регулярное выражение (регистронезависимое), применяется к заголовку и описанию уже найденных результатов — оставляет только совпадения. Если пусто — берутся все найденные.", "example": "(?:КЛЕВЕРСПОРТ|Клевер[- ]?Спорт)" },
          "feedUrl": { "type": "string", "description": "URL поиска/источника, передаётся автоматизации как есть (ежесуточно). Яндекс, Google, RSS/API-лента. Если указан — автоматизация тянет этот URL напрямую вместо запроса из query/keywords.", "example": "https://yandex.ru/search/?text=%D0%9A%D0%9B%D0%95%D0%92%D0%95%D0%A0%D0%A1%D0%9F%D0%9E%D0%A0%D0%A2&lr=213&within=1" },
          "archived": { "type": "boolean" },
          "createdBy": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "ScenarioInput": {
        "type": "object",
        "required": ["projectId", "name"],
        "properties": {
          "projectId": { "type": "string" },
          "name": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" }, "example": ["ФЛГ"] },
          "sources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Сайт/источник, где искать: домен, site: или полный URL.",
            "examples": [["site:kommersant.ru", "https://www.interfax.ru"]]
          },
          "negativeKeywords": { "type": "array", "items": { "type": "string" } },
          "positiveKeywords": { "type": "array", "items": { "type": "string" } },
          "regex": { "type": "string", "description": "Регулярное выражение (регистронезависимое), применяется к заголовку и описанию найденных результатов — оставляет только совпадения.", "example": "(?:КЛЕВЕРСПОРТ|Клевер[- ]?Спорт)" },
          "feedUrl": { "type": "string", "description": "URL поиска/источника, передаётся автоматизации как есть (ежесуточно). Годится Яндекс, Google, RSS/API-лента. Если указан — автоматизация тянет этот URL напрямую вместо составления запроса из query/keywords.", "example": "https://yandex.ru/search/?text=%D0%9A%D0%9B%D0%95%D0%92%D0%95%D0%A0%D0%A1%D0%9F%D0%9E%D0%A0%D0%A2&within=1" },
          "archived": { "type": "boolean" }
        }
      },
      "ScenarioResponse": { "type": "object", "properties": { "scenario": { "$ref": "#/components/schemas/Scenario" } } },
      "ScenariosResponse": {
        "type": "object",
        "properties": {
          "boardId": { "type": "string", "description": "Только в /api/cron/scenarios" },
          "scenarios": { "type": "array", "items": { "$ref": "#/components/schemas/Scenario" } }
        }
      },
      "Mention": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "title": { "type": "string" },
          "publishedAt": { "type": "string", "format": "date" },
          "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
          "urgent": { "type": "boolean" },
          "eventType": { "type": "string", "enum": ["article", "news"], "default": "news", "description": "Тип события: статья/публикация (article) или новость (news)." },
          "comment": { "type": "string", "description": "Краткая информация/сниппет" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MentionInput": {
        "type": "object",
        "properties": {
          "project": { "type": "string", "description": "ID проекта; для GET/PUT/DELETE — в query" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "title": { "type": "string" },
          "publishedAt": { "type": "string", "format": "date" },
          "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
          "urgent": { "type": "boolean" },
          "eventType": { "type": "string", "enum": ["article", "news"], "default": "news", "description": "Тип события: статья/публикация (article) или новость (news)." },
          "comment": { "type": "string" }
        }
      },
      "MentionResponse": { "type": "object", "properties": { "mention": { "$ref": "#/components/schemas/Mention" } } },
      "MentionsResponse": { "type": "object", "properties": { "mentions": { "type": "array", "items": { "$ref": "#/components/schemas/Mention" } } } },
      "ImportItem": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "projectId": { "type": "string", "description": "Можно не указывать, если задан на уровне body" },
          "url": { "type": "string", "description": "Ссылка на материал — ключ дедупликации" },
          "source": { "type": "string", "description": "СМИ/источник" },
          "title": { "type": "string", "description": "Заголовок материала" },
          "comment": { "type": "string", "description": "Краткая информация/сниппет" },
          "publishedAt": { "type": "string", "format": "date", "example": "2026-09-08" },
          "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
          "eventType": { "type": "string", "enum": ["article", "news"], "default": "news", "description": "Тип события: статья/публикация (article) или новость (news)." },
          "urgent": { "type": "boolean" },
          "sourceType": { "type": "string", "default": "auto" }
        }
      },
      "ImportMentionsRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": { "$ref": "#/components/schemas/ImportItem" }
          },
          "providerName": { "type": "string", "default": "auto", "description": "Кто разместил (visible createdBy)" },
          "projectId": { "type": "string", "description": "Общий проект для всех items" }
        },
        "example": {
          "providerName": "auto",
          "projectId": "project-42",
          "items": [
            { "url": "https://iz.ru/news/123", "source": "Известия", "title": "Клеверспорт открыл новый офис", "publishedAt": "2026-09-08", "sentiment": "positive", "eventType": "article", "comment": "открытие офиса в Москве" },
            { "url": "https://ria.ru/456", "source": "РИА Новости", "title": "Суд обязал Клеверспорт заплатить", "publishedAt": "2026-09-07", "sentiment": "negative", "eventType": "news" }
          ]
        }
      },
      "ImportMentionsResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "inserted": { "type": "integer" },
          "skipped": { "type": "integer" },
          "dropped": {
            "type": "array",
            "items": { "type": "object", "properties": { "index": { "type": "integer" }, "reason": { "type": "string" }, "message": { "type": "string" } } }
          }
        }
      },
      "SearchRunRequest": {
        "type": "object",
        "properties": {
          "scenarioId": { "type": "integer", "description": "Запустить только один сценарий; без поля — все активные" },
          "pages": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1, "description": "Сколько страниц выдачи Яндекса запросить" }
        },
        "example": { "pages": 1 }
      },
      "SearchRunResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "ran": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SearchRunEntry" }
          }
        }
      },
      "SearchRunEntry": {
        "type": "object",
        "properties": {
          "scenarioId": { "type": "integer" },
          "name": { "type": "string" },
          "projectId": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "error"] },
          "found": { "type": "integer", "description": "Строк в выдаче до фильтров" },
          "inserted": { "type": "integer", "description": "Новых упоминаний сохранено" },
          "skipped": { "type": "integer", "description": "Дублей пропущено" },
          "note": { "type": "string" }
        }
      },
      "SearchLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "scenarioId": { "type": "integer", "nullable": true },
          "scenarioName": { "type": "string", "description": "Название фильтра (сценария поиска)" },
          "status": { "type": "string", "description": "Результат запуска, напр.: ok, error, partial" },
          "note": { "type": "string", "description": "Примечания" },
          "severity": { "type": "string", "enum": ["info", "debug", "important"], "description": "Критичность" },
          "projectId": { "type": "string", "description": "Проект сценария (если определён)" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SearchLogsRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "providerName": { "type": "string", "description": "Кто выполнил запуск, показывается в логе. Если не передано — 'auto'. Можно передавать, например, 'автоматизация' или имя бота." },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": { "$ref": "#/components/schemas/SearchLogItem" }
          }
        },
        "example": {
          "providerName": "автоматизация",
          "items": [
            { "scenarioId": 1, "scenarioName": "ФЛГ — мониторинг", "status": "ok", "note": "найдено 4 публикации, 3 пропущено как дубли", "severity": "info" },
            { "scenarioName": "Сивух — Яндекс", "status": "error", "note": "сеть недоступна, запрос не выполнен", "severity": "important" }
          ]
        }
      },
      "SearchLogItem": {
        "type": "object",
        "required": ["scenarioName"],
        "properties": {
          "scenarioId": { "type": "integer", "description": "ID сценария (если известен)" },
          "scenarioName": { "type": "string", "description": "Название фильтра" },
          "projectId": { "type": "string", "description": "ID проекта, к которому относится запуск (обязательно, если scenarioId не передан)" },
          "status": { "type": "string", "default": "ok", "description": "Результат запуска: ok | error | partial | …" },
          "note": { "type": "string", "description": "Примечания" },
          "severity": { "type": "string", "enum": ["info", "debug", "important"], "default": "info", "description": "Критичность" }
        },
        "example": {
          "scenarioId": 1,
          "scenarioName": "ФЛГ — мониторинг",
          "projectId": "project-42",
          "status": "ok",
          "note": "найдено 4 публикации",
          "severity": "info"
        }
      },
      "SearchLogsResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "inserted": { "type": "integer", "description": "Сколько записей записано" },
          "failed": { "type": "integer", "description": "Сколько элементов не записано" },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer", "description": "ID записанного лога" },
                "scenarioName": { "type": "string" },
                "error": { "type": "string", "description": "Текст ошибки записи, если элемент не сохранился" }
              }
            }
          }
        }
      },
      "LoginRequest": { "type": "object", "required": ["login_id", "password"], "properties": { "login_id": { "type": "string" }, "password": { "type": "string" } } },
      "Source": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "projectId": { "type": "string", "description": "ID проекта (пусто — общий пул)" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["smi", "portal", "aggregator", "telegram", "other"], "default": "smi" },
          "lang": { "type": "string", "enum": ["ru", "en", "other"], "default": "ru" },
          "region": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "paused"], "default": "active" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SourceInput": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "projectId": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["smi", "portal", "aggregator", "telegram", "other"], "default": "smi" },
          "lang": { "type": "string", "enum": ["ru", "en", "other"], "default": "ru" },
          "region": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "paused"], "default": "active" }
        },
        "example": { "projectId": "a5amd6469y96drojnrf3ymiacpe", "name": "Trans.ru", "url": "https://trans.ru/news", "type": "smi", "lang": "ru", "region": "RU" }
      },
      "MeResponse": {
        "type": "object",
        "properties": { "user": { "type": "object" }, "role": { "type": "object" }, "access": { "type": "object", "properties": { "admin": { "type": "boolean" }, "staffProjectsPath": { "type": "string" } } } }
      },
      "Project": { "type": "object", "properties": { "id": { "type": "string" }, "label": { "type": "string" } } },
      "ProjectsResponse": { "type": "object", "properties": { "projects": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } },
      "TasksResponse": { "type": "object", "properties": { "tasks": { "type": "array", "items": { "type": "object" } }, "meta": { "type": "object" } } },
      "MentionsStatsResponse": {
        "type": "object",
        "properties": {
          "stats": {
            "type": "array",
            "items": { "type": "object", "properties": { "month": { "type": "string", "example": "2026-08" }, "positive": { "type": "integer" }, "neutral": { "type": "integer" }, "negative": { "type": "integer" }, "total": { "type": "integer" }, "mediaIndex": { "type": "integer" } } }
          }
        }
      },
      "AdminProject": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "label": { "type": "string" },
          "token": { "type": "string" },
          "link": { "type": "string", "example": "/l/abc123" },
          "factsCount": { "type": "integer" },
          "publishedCount": { "type": "integer" },
          "reachSum": { "type": "integer" },
          "archived": { "type": "boolean" }
        }
      },
      "StatusOptions": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
      "ProjectSettings": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "clientNameRu": { "type": "string" },
          "clientNameEn": { "type": "string" },
          "ceoName": { "type": "string" },
          "website": { "type": "string" },
          "socialLinks": { "type": "array", "items": { "type": "object", "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
          "speakerProfile": { "type": "string" },
          "otherInfo": { "type": "string" },
          "archived": { "type": "boolean" },
          "searchKeywords": { "type": "array", "items": { "type": "string" } },
          "negativeKeywords": { "type": "array", "items": { "type": "string" } },
          "positiveKeywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}