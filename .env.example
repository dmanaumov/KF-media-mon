# --- Для docker-compose (Dokploy) ---
POSTGRES_DB=prmonitor
POSTGRES_USER=pruser
POSTGRES_PASSWORD=change-me

# --- Приложение ---
# Локальный запуск без compose — переопределить DATABASE_URL напрямую:
# DATABASE_URL=postgres://pruser:prpass@localhost:5432/prmonitor
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pr-db:5432/${POSTGRES_DB}

PORT=3000

# --- Mattermost (обязательно для работы интерфейса) ---
# Адрес сервера Mattermost, например https://messenger.example.com
MATTERMOST_URL=
# Авторизация — логин/пароль (сессионная). PAT-токен (MATTERMOST_TOKEN)
# используется только если логин/пароль не заданы.
MATTERMOST_LOGIN_ID=
MATTERMOST_PASSWORD=
# MATTERMOST_TOKEN=
# TeamId и BoardId доски «PR-департамент»:
MATTERMOST_TEAM_ID=4wd5nx3wffbmjg3a9cjjcgi8tw
MATTERMOST_BOARD_ID=b4h1ef6wwnfnjze9m6jghwfugzr

# --- Кто админ (через запятую, email или логин Mattermost) ---
# ADMIN_EMAILS=
# ADMIN_LOGINS=

# --- Ключ для автоматизации (n8n/внешние системы) ---
# Передаётся заголовком X-Automation-Api-Key на эндпоинтах /api/cron/*
AUTOMATION_API_KEY=