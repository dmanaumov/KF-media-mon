# --- Для docker-compose (Dokploy) ---
POSTGRES_DB=prmonitor
POSTGRES_USER=pruser
POSTGRES_PASSWORD=change-me

# --- Приложение ---
# Локальный запуск без compose — переопределить DATABASE_URL напрямую:
# DATABASE_URL=postgres://pruser:prpass@localhost:5432/prmonitor
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

STAFF_AUTH_USER=admin
STAFF_AUTH_PASSWORD=change-me

PORT=3000
SESSION_SECRET=change-me-too
